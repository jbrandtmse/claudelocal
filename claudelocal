#!/usr/bin/env bash
# claudelocal - run Claude Code CLI against a local model hosted on Ollama,
# LM Studio, or oMLX. Works with localhost or any reachable host/IP on your network.
#
#   Ollama:    Anthropic-compatible endpoint at http://<host>:11434  (no /v1 suffix)
#   LM Studio: Anthropic-compatible endpoint at http://<host>:1234   (no /v1 suffix)
#   oMLX:      Anthropic-compatible endpoint at http://<host>:8000   (no /v1 suffix)
#
# Docs:
#   https://docs.ollama.com/integrations/claude-code
#   https://lmstudio.ai/docs/integrations/claude-code
#   https://github.com/jundot/omlx
set -euo pipefail

resolve_script_dir() {
  local src="$1"
  while [ -h "$src" ]; do
    local dir
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  cd -P "$(dirname "$src")" && pwd
}
SCRIPT_DIR="$(resolve_script_dir "${BASH_SOURCE[0]}")"

# ---------------------------------------------------------------------------
# Defaults (overridden by config file, then by command-line flags)
# ---------------------------------------------------------------------------
BACKEND="ollama"          # ollama | lmstudio | omlx
HOST="localhost"          # hostname or IP; may include http:// scheme
PORT=""                   # blank = backend default (11434 ollama / 1234 lmstudio / 8000 omlx)
MODEL=""                  # blank = auto-detect first model the server reports
CONTEXT_TOKENS="65536"    # context window to tell Claude Code about
AUTO_COMPACT_TOKENS=""    # blank = auto-calculate as 75% of CONTEXT_TOKENS
AUTH_TOKEN=""             # blank = placeholder ("ollama" / "lmstudio" / "omlx")
TIMEOUT_MS=""             # blank = Claude Code's own default (600000ms / 10 min)

CONFIG_FILE="$SCRIPT_DIR/claudelocal.conf"

usage() {
  cat <<'EOF'
claudelocal - run Claude Code against a local Ollama, LM Studio, or oMLX model.

Usage: claudelocal [options] [--] [claude args...]

Options:
  -m, --model NAME      Model name (overrides config; default: first model
                        the server reports, e.g. qwen2.5-coder:7b)
  -b, --backend NAME    ollama | lmstudio | omlx   (default: ollama or config)
  -H, --host HOST       Hostname or IP of the model server (default: localhost)
  -p, --port PORT       Port (default: 11434 for Ollama, 1234 for LM Studio,
                        8000 for oMLX).
                        A non-numeric value after -p is passed to claude
                        (claude's own -p/--print flag keeps working)
  -x, --context N       Context window in tokens (default: 65536 or config);
                        auto-compact window is calculated as 75% of this
  -k, --token TOKEN     Auth token if the server requires one (LM Studio
                        "Require Authentication", or the oMLX API key);
                        placeholder otherwise
  -t, --timeout MS      API request timeout in milliseconds (default: Claude
                        Code's own default of 600000 / 10 min). Raise this if
                        slow local inference causes "API Error (Request timed
                        out)"
  -c, --config FILE     Use a different config file
  -h, --help            Show this help

Any other arguments are passed through to claude, e.g.:

  claudelocal -m qwen2.5-coder:14b -- --verbose
  claudelocal -b lmstudio -H 192.168.1.50 -p 1234

Config file: claudelocal.conf next to this script (see claudelocal.conf.example).
Precedence: command-line flag > config file > built-in default.
EOF
}

# ---------------------------------------------------------------------------
# Pre-pass: find -c/--config so it can be honored before reading the config
# ---------------------------------------------------------------------------
PREV=""
for ARG in "$@"; do
  if [ "$PREV" = "config" ]; then CONFIG_FILE="$ARG"; PREV=""; continue; fi
  case "$ARG" in
    -c|--config) PREV="config" ;;
    --config=*)  CONFIG_FILE="${ARG#*=}" ;;
  esac
done

# ---------------------------------------------------------------------------
# Config file (simple KEY=VALUE, # comments, blank lines ok)
# ---------------------------------------------------------------------------
if [ -f "$CONFIG_FILE" ]; then
  while IFS= read -r LINE || [ -n "$LINE" ]; do
    LINE="${LINE%%#*}"                              # strip comments
    LINE="$(echo "$LINE" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
    [ -z "$LINE" ] && continue
    KEY="${LINE%%=*}"; VALUE="${LINE#*=}"
    KEY="$(echo "$KEY" | sed 's/[[:space:]]*$//')"
    VALUE="$(echo "$VALUE" | sed 's/^[[:space:]]*//;s/^["'\'']//;s/["'\'']$//')"
    case "$KEY" in
      BACKEND)        BACKEND="$VALUE" ;;
      HOST)           HOST="$VALUE" ;;
      PORT)           PORT="$VALUE" ;;
      MODEL)          MODEL="$VALUE" ;;
      CONTEXT_TOKENS) CONTEXT_TOKENS="$VALUE" ;;
      AUTO_COMPACT_TOKENS) AUTO_COMPACT_TOKENS="$VALUE" ;;
      AUTH_TOKEN)     AUTH_TOKEN="$VALUE" ;;
      TIMEOUT_MS)     TIMEOUT_MS="$VALUE" ;;
      *) echo "claudelocal: warning: ignoring unknown config key '$KEY'" >&2 ;;
    esac
  done < "$CONFIG_FILE"
fi

# ---------------------------------------------------------------------------
# Command-line flags (unknown args pass through to claude)
# ---------------------------------------------------------------------------
CLAUDE_ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    -m|--model)        MODEL="${2:?missing value for $1}"; shift 2 ;;
    --model=*)         MODEL="${1#*=}"; shift ;;
    -b|--backend)      BACKEND="${2:?missing value for $1}"; shift 2 ;;
    --backend=*)       BACKEND="${1#*=}"; shift ;;
    -H|--host)         HOST="${2:?missing value for $1}"; shift 2 ;;
    --host=*)          HOST="${1#*=}"; shift ;;
    -p|--port)
      # Numeric value => our port flag; otherwise it's claude's -p (print mode)
      if [ $# -ge 2 ] && [[ "$2" =~ ^[0-9]+$ ]]; then PORT="$2"; shift 2; else CLAUDE_ARGS+=("$1"); shift; fi ;;
    --port=*)          PORT="${1#*=}"; shift ;;
    -x|--context)      CONTEXT_TOKENS="${2:?missing value for $1}"; shift 2 ;;
    --context=*)       CONTEXT_TOKENS="${1#*=}"; shift ;;
    -k|--token)        AUTH_TOKEN="${2:?missing value for $1}"; shift 2 ;;
    --token=*)         AUTH_TOKEN="${1#*=}"; shift ;;
    -t|--timeout)      TIMEOUT_MS="${2:?missing value for $1}"; shift 2 ;;
    --timeout=*)       TIMEOUT_MS="${1#*=}"; shift ;;
    -c|--config)       shift 2 ;;   # already handled in pre-pass
    --config=*)        shift ;;
    -h|--help)         usage; exit 0 ;;
    --)                shift; while [ $# -gt 0 ]; do CLAUDE_ARGS+=("$1"); shift; done ;;
    *)                 CLAUDE_ARGS+=("$1"); shift ;;
  esac
done

# ---------------------------------------------------------------------------
# Resolve backend-specific defaults
# ---------------------------------------------------------------------------
case "$(echo "$BACKEND" | tr '[:upper:]' '[:lower:]')" in
  ollama)             BACKEND="ollama";   DEFAULT_PORT="11434" ;;
  lmstudio|lm-studio|lms) BACKEND="lmstudio"; DEFAULT_PORT="1234" ;;
  omlx)               BACKEND="omlx";     DEFAULT_PORT="8000" ;;
  *) echo "claudelocal: ERROR: unknown backend '$BACKEND' (expected 'ollama', 'lmstudio', or 'omlx')" >&2; exit 1 ;;
esac

[ -z "$PORT" ] && PORT="$DEFAULT_PORT"

# Build the base URL (HOST may be a bare host/IP or a full URL)
HOST="${HOST%/}"
case "$HOST" in
  http://*|https://*) BASE_URL="$HOST" ;;
  *)                  BASE_URL="http://$HOST" ;;
esac
case "$BASE_URL" in
  *:"$PORT") : ;;                       # port already in the URL
  *)         BASE_URL="$BASE_URL:$PORT" ;;
esac

[ -z "$AUTH_TOKEN" ] && AUTH_TOKEN="$BACKEND"   # non-empty placeholder; not validated locally

# ---------------------------------------------------------------------------
# Reachability check + model auto-detect
# ---------------------------------------------------------------------------
# The token is sent because oMLX (and LM Studio with "Require Authentication")
# reject unauthenticated /v1/models requests; servers without auth ignore it.
MODELS_JSON=""
if command -v curl >/dev/null 2>&1; then
  MODELS_RESP="$(curl -s -m 5 -w '\n%{http_code}' -H "Authorization: Bearer $AUTH_TOKEN" "$BASE_URL/v1/models" 2>/dev/null || true)"
  HTTP_CODE="${MODELS_RESP##*$'\n'}"
  MODELS_JSON="${MODELS_RESP%$'\n'*}"
  case "$HTTP_CODE" in
    200) ;;
    401|403)
      MODELS_JSON=""
      echo "claudelocal: WARNING: $BASE_URL rejected the auth token (HTTP $HTTP_CODE)" >&2
      echo "  Set AUTH_TOKEN in claudelocal.conf or pass -k/--token (the oMLX API key," >&2
      echo "  or the LM Studio token). Continuing anyway..." >&2 ;;
    000|"")
      MODELS_JSON=""
      echo "claudelocal: WARNING: could not reach $BASE_URL" >&2
      echo "  Is the $BACKEND server running on $HOST:$PORT? Continuing anyway..." >&2 ;;
    *)
      MODELS_JSON=""
      echo "claudelocal: WARNING: $BASE_URL/v1/models returned HTTP $HTTP_CODE. Continuing anyway..." >&2 ;;
  esac
fi

if [ -z "$MODEL" ]; then
  if [ -n "$MODELS_JSON" ]; then
    MODEL="$(printf '%s' "$MODELS_JSON" | grep -o '"id"[[:space:]]*:[[:space:]]*"[^"]*"' | head -n 1 | cut -d'"' -f4)"
  fi
  if [ -z "$MODEL" ]; then
    echo "claudelocal: ERROR: no model configured and none could be auto-detected." >&2
    echo "  Set MODEL in claudelocal.conf or pass -m/--model." >&2
    exit 1
  fi
  echo "claudelocal: auto-detected model '$MODEL'"
fi

# ---------------------------------------------------------------------------
# Environment for the launched Claude Code session
# ---------------------------------------------------------------------------
export ANTHROPIC_BASE_URL="$BASE_URL"
export ANTHROPIC_AUTH_TOKEN="$AUTH_TOKEN"
unset ANTHROPIC_API_KEY     # avoid a stray cloud key taking precedence

# Every model tier and subagent uses the same local model
export ANTHROPIC_MODEL="$MODEL"
export ANTHROPIC_DEFAULT_FABLE_MODEL="$MODEL"
export ANTHROPIC_DEFAULT_OPUS_MODEL="$MODEL"
export ANTHROPIC_DEFAULT_SONNET_MODEL="$MODEL"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="$MODEL"
export ANTHROPIC_SMALL_FAST_MODEL="$MODEL"
export CLAUDE_CODE_SUBAGENT_MODEL="$MODEL"

# Auto-compact window: leave ~25% headroom below the real context window so
# compaction starts at ~70-75% usage, with room for the response and overhead.
if [ -z "$AUTO_COMPACT_TOKENS" ]; then
  AUTO_COMPACT_TOKENS=$(( CONTEXT_TOKENS * 3 / 4 ))
fi

# Context / compaction tuned to the local model's window
export CLAUDE_CODE_MAX_CONTEXT_TOKENS="$CONTEXT_TOKENS"
export CLAUDE_CODE_AUTO_COMPACT_WINDOW="$AUTO_COMPACT_TOKENS"

# Keep the session local-first. Tool search needs an API that honors
# defer_loading and tool_reference blocks; Ollama, LM Studio, and oMLX don't.
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
export ENABLE_TOOL_SEARCH=false

# Omit the attribution block (client version + prompt fingerprint) from the
# start of the system prompt so it can't disturb the server's prompt cache.
# Recommended by LM Studio and oMLX.
export CLAUDE_CODE_ATTRIBUTION_HEADER=0

# oMLX: deny the LSP tool. Its schema is added to the tools array when a
# language server connects mid-session, which forces oMLX to re-prefill the
# whole conversation. Skipped if the user passes their own --disallowedTools.
# The =form keeps the variadic option from swallowing a following prompt.
if [ "$BACKEND" = "omlx" ]; then
  DENY_LSP=1
  for ARG in "${CLAUDE_ARGS[@]+"${CLAUDE_ARGS[@]}"}"; do
    case "$ARG" in --disallowedTools|--disallowedTools=*|--disallowed-tools|--disallowed-tools=*) DENY_LSP=0 ;; esac
  done
  if [ "$DENY_LSP" = 1 ]; then
    CLAUDE_ARGS=("--disallowedTools=LSP" "${CLAUDE_ARGS[@]+"${CLAUDE_ARGS[@]}"}")
  fi
fi

# Per-request API timeout: only override Claude Code's own default (600000ms)
# when the user configured one, since slow local inference is often fine at
# the default and we shouldn't silently mask other problems.
[ -n "$TIMEOUT_MS" ] && export API_TIMEOUT_MS="$TIMEOUT_MS"

echo "claudelocal: backend=$BACKEND url=$BASE_URL model=$MODEL context=$CONTEXT_TOKENS compact=$AUTO_COMPACT_TOKENS${TIMEOUT_MS:+ timeout=$TIMEOUT_MS}"
exec claude "${CLAUDE_ARGS[@]+"${CLAUDE_ARGS[@]}"}"
